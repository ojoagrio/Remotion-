{
  "name": "remotion-video",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto de edición de video con Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render HelloWorld out/video.mp4",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit",
    "render:n64": "remotion render EscenaN64 out/escena-n64.mp4",
    "voces": "node scripts/generar-voces.mjs",
    "render:tiktok": "remotion render YaVoySaliendo out/ya-voy-saliendo.mp4",
    "render:ia": "remotion render BugChiquito out/bug-chiquito.mp4",
    "sonidos": "python3 scripts/generar-sonidos.py",
    "render:chancla": "remotion render ChanclaIA out/la-chancla.mp4",
    "render:chisme": "remotion render ElChisme out/el-chisme.mp4",
    "render:industria": "remotion render Industria out/industria-tech.mp4",
    "ritmo": "python3 scripts/ritmo-viral.py",
    "render:tipos": "remotion render TiposIA out/tipos-ia.mp4"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/media-utils": "4.0.533",
    "@remotion/three": "4.0.533",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.533",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
